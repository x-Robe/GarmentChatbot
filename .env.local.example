# Copy to .env.local, chmod 600 .env.local. Never copy historical credentials.
# Empty secrets deliberately prevent live search until NEW authorized values exist.
POE_API=
POE_URL=
OPENAI_MODEL=
QDRANT_URL=
QDRANT_API=
QDRANT_COLLECTION=
CLIP_MODEL=patrickjohncyh/fashion-clip
CORS_ORIGINS=https://garmentchatbot.web.app,https://garmentchatbot.firebaseapp.com,http://127.0.0.1:8766,http://localhost:8766
LOCAL_API_PORT=8765
LOCAL_FRONTEND_PORT=8766
API_REQUESTS_PER_MINUTE=30
API_MAX_INFLIGHT=2
# Reuse existing local Hugging Face cache; no HF_TOKEN needed for complete cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Optional named tunnel: supply an EXISTING authorized config and stable URL.
# CLOUDFLARED_CONFIG=/absolute/private/path/config.yml
# LOCAL_TUNNEL_ORIGIN=https://api.YOUR_OWN_DOMAIN
