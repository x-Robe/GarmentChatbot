# Copy to backend/.env for local development only. Production: Render Environment.
# Use NEW authorized credentials. Never reuse historical exposed values.
POE_API=REPLACE_WITH_ROTATED_PROVIDER_KEY
POE_URL=https://YOUR_APPROVED_PROVIDER/v1
OPENAI_MODEL=YOUR_APPROVED_MODEL
# Standard OpenAI alternative: UNSET POE_API and POE_URL; set OPENAI_API_KEY.
# OPENAI_API_KEY=REPLACE_WITH_ROTATED_KEY
QDRANT_URL=https://YOUR_EXISTING_QDRANT_HOST
QDRANT_API=REPLACE_WITH_ROTATED_QDRANT_KEY
QDRANT_COLLECTION=YOUR_EXISTING_COLLECTION
# Must match ingestion model; confirm with collection owner.
CLIP_MODEL=patrickjohncyh/fashion-clip
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HF_HOME=/tmp/garment-hf-cache
# HF_TOKEN: optional, inject only if required, with a newly authorized token.
MAX_CONTEXT_MESSAGES=200
MAX_CONTEXT_CHARS=60000
API_REQUESTS_PER_MINUTE=30
API_MAX_INFLIGHT=2
