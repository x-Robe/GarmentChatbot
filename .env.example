# Copy this template to backend/.env, NOT frontend/.env or release-root .env.
# Never commit the populated file. Fill in service/model identifiers yourself.
# Compatible provider configuration: replace placeholders with your private values.
POE_API=YOUR_API_KEY_HERE
POE_URL=YOUR_APPROVED_PROVIDER_BASE_URL_HERE
# Alternative: standard OpenAI SDK defaults. REMOVE/UNSET both POE_API and POE_URL
# above, then uncomment this line. An empty POE_API/POE_URL is not an unset value.
# OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_MODEL=YOUR_LLM_MODEL_ID_HERE
QDRANT_URL=YOUR_QDRANT_URL_HERE
# Required only when the Qdrant server requires authentication.
QDRANT_API=
QDRANT_COLLECTION=YOUR_QDRANT_COLLECTION_HERE
# Must be identical to the embedding model used to populate the collection.
CLIP_MODEL=YOUR_MATCHING_FASHIONCLIP_MODEL_ID_HERE
# Optional for authorized model download; omit invalid/unused tokens.
HF_TOKEN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_CONTEXT_MESSAGES=200
MAX_CONTEXT_CHARS=60000
# Optional offline ingestion configuration. Ingestion writes Qdrant; review first.
PRODUCT_FILE=data/products.json
BATCH_SIZE=32
